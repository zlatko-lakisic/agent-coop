{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENTCOOP}} check --as {{AGENT_NAME}} --summary"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENTCOOP}} check --as {{AGENT_NAME}} --summary && {{AGENTCOOP}} touch --as {{AGENT_NAME}}"
          }
        ]
      }
    ]
  }
}
